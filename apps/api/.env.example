# Local development defaults. Render production values are set in render.yaml.
SECRET_KEY=change-this-in-production
# Relative SQLite paths are resolved from apps/api, regardless of where uvicorn is started.
DATABASE_URL=sqlite:///./gst_bharat.db
UPLOAD_DIR=../../storage/uploads
EXPORT_DIR=../../storage/exports
MAX_UPLOAD_MB=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_EMAIL=
ADMIN_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
